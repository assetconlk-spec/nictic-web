# ── PayHere ────────────────────────────────────────────────────
# Get these from your PayHere merchant dashboard:
# https://www.payhere.lk/merchants/settings
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Set to "true" for sandbox / testing, "false" for live payments
VITE_PAYHERE_SANDBOX=true

# ── Resend (email notifications) ───────────────────────────────
RESEND_API_KEY=
NOTIFY_EMAIL=hello@nictic.travel

# ── PocketBase (used in payhere-notify webhook) ─────────────────
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
VITE_PB_URL=https://tourism-pocketbase-production.up.railway.app
