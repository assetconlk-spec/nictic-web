# ── PayHere ────────────────────────────────────────────────────
# Merchant dashboard: https://www.payhere.lk/merchants/settings
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# "true" = sandbox/testing  |  "false" = live payments
VITE_PAYHERE_SANDBOX=true

# ── PocketBase ──────────────────────────────────────────────────
VITE_PB_URL=https://nictic-web-production.up.railway.app
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# ── Resend (optional — email on payment received) ───────────────
RESEND_API_KEY=
NOTIFY_EMAIL=hello@nictic.travel
